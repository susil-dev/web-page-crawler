    "@anthropic-ai/sdk": "^1.12.0",
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
