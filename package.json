  "private": true,
  "description": "Chrome extension: grab tables and lists from the page you're on or crawl a site; export Excel, CSV, Markdown, JSON or Notion; local library; Claude summaries.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
